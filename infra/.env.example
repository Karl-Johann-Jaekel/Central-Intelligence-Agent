# Copy to infra/.env and replace every generated-by-cia-setup value. Never commit infra/.env.

# Database `cia` on the Postgres instance of the BIS stack; role without access to `warehouse`.
CIA_PG_DB=cia
CIA_PG_USER=cia
CIA_PG_PASSWORD=generated-by-cia-setup
# Host and port for local runs outside Docker (compose sets postgres:5432).
CIA_PG_HOST=127.0.0.1
CIA_PG_PORT=55432

# Shared with the BIS outbox (BIS_CIA_WEBHOOK_SECRET in the BIS infra/.env).
CIA_WEBHOOK_SECRET=generated-by-cia-setup

# Local port of cia-api (127.0.0.1 only).
CIA_API_PORT=8200
