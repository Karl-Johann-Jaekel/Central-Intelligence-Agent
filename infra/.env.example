# Copy to infra/.env and replace every generated-by-cia-setup value. Never commit infra/.env.

# Database `cia` on the Postgres instance of the BIS stack; role without access to `warehouse`.
CIA_PG_DB=cia
CIA_PG_USER=cia
CIA_PG_PASSWORD=generated-by-cia-setup
# Host and port for local runs outside Docker (compose sets postgres:5432).
CIA_PG_HOST=127.0.0.1
CIA_PG_PORT=55432

# Shared with the BIS outbox (BIS_CIA_WEBHOOK_SECRET in the BIS infra/.env).
CIA_WEBHOOK_SECRET=generated-by-cia-setup

# Local port of cia-api (127.0.0.1 only).
CIA_API_PORT=8200

# BIS API (read-only tools). Local runs: published port of the BIS api; compose sets http://api:8000.
CIA_BIS_API_URL=http://127.0.0.1:8102
# Keycloak client `cia-agent` (client credentials). Leave CIA_OIDC_TOKEN_URL empty while the BIS
# API runs with BIS_AUTH_ENABLED=false; compose uses the keycloak service inside the network.
CIA_OIDC_TOKEN_URL=
CIA_AGENT_CLIENT_ID=cia-agent
CIA_AGENT_CLIENT_SECRET=generated-by-bis-keycloak

# LLM: mistral or none (fallback mode without agent text).
CIA_LLM_PROVIDER=mistral
CIA_MISTRAL_API_KEY=from-console.mistral.ai
# Free tier may train on inputs: public data only.
CIA_MISTRAL_DATA_CLASSES=public
CIA_LLM_MODEL_CENTRAL=mistral-medium-latest
CIA_LLM_MODEL_DEPARTMENT=mistral-small-latest
# Price per million tokens in EUR (0 on the free tier).
CIA_LLM_PRICE_IN_EUR_PER_MTOK=0
CIA_LLM_PRICE_OUT_EUR_PER_MTOK=0

# Central agent: topics per report, token budget per run, nightly fallback run (UTC, empty = off).
CIA_MAX_TOPICS=3
CIA_RUN_TOKEN_BUDGET=60000
CIA_NIGHTLY_AT=03:00
